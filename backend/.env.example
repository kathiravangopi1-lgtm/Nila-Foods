JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters-long
# Optional; defaults to JWT_SECRET when unset.
OTP_HASH_SECRET=
JWT_EXPIRES_IN=7d
PORT=5000
DEFAULT_CURRENCY=INR
CORS_ORIGIN=https://nila-foods-frontend.onrender.com,http://localhost:5173,http://127.0.0.1:5173
GOOGLE_CLIENT_ID=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
