# Keep the existing Cloudinary URL on the backend only.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Set RAZORPAY_MODE=test or live to match the key prefix and dashboard mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=test
